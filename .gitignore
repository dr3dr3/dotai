# MemPalace — never commit palace data or logs (large, machine-specific,
# contains verbatim session/doc text). Config files are committed; state is not.
mempalace/state/
mempalace/**/seed.log

# Python bytecode from running scripts/ directly
__pycache__/

# Generated by scripts/setup.sh when this checkout is set up as a target repo:
# the unfilled CLAUDE.md template and the skills links read by Cursor. Never
# authored here; without these lines every setup run leaves the tree "dirty".
/CLAUDE.md
/.claude/
